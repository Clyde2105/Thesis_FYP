<?xml version="1.0"?>
<robot name="artbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="ros2_control_yaml" default="$(find artbot_sim)/config/ros2_control.yaml"/>

  <material name="blue"><color rgba="0 0 0.8 1"/></material>
  <material name="black"><color rgba="0 0 0 1"/></material>
  <material name="red"><color rgba="1 0 0 1"/></material>

  <link name="base_link">
    <visual>
      <geometry><box size="0.4 0.3 0.1"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="0.4 0.3 0.1"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.04" ixy="0.0" ixz="0.0" iyy="0.07" iyz="0.0" izz="0.09"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="prefix side">
    <link name="${prefix}_wheel">
      <visual>
        <origin rpy="1.5707 0 0" xyz="0 0 0"/>
        <geometry><cylinder radius="0.05" length="0.04"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin rpy="1.5707 0 0" xyz="0 0 0"/>
        <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0006"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin rpy="0 0 0" xyz="0 ${side * 0.17} -0.05"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left" side="1"/>
  <xacro:wheel prefix="right" side="-1"/>

  <link name="front_caster">
    <visual><geometry><sphere radius="0.049"/></geometry><material name="black"/></visual>
    <collision><geometry><sphere radius="0.049"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <origin xyz="0.15 0 -0.05"/>
  </joint>

  <link name="rear_caster">
    <visual><geometry><sphere radius="0.049"/></geometry><material name="black"/></visual>
    <collision><geometry><sphere radius="0.049"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster"/>
    <origin xyz="-0.15 0 -0.05"/>
  </joint>

  <link name="pen_link">
    <visual>
      <geometry><cylinder radius="0.01" length="0.12"/></geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="pen_joint" type="fixed">
    <parent link="base_link"/>
    <child link="pen_link"/>
    <origin xyz="0.2 0 -0.04"/> 
  </joint>

  <ros2_control name="GazeboSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/><state_interface name="velocity"/><state_interface name="position"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/><state_interface name="velocity"/><state_interface name="position"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg ros2_control_yaml)</parameters>
    </plugin>
  </gazebo>
</robot>