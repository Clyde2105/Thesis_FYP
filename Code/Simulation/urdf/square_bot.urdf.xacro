<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="square_bot">
  <xacro:arg name="ros2_control_yaml" default=""/>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <link name="pen_link">
    <visual>
      <geometry><cylinder radius="0.01" length="0.1"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
  </link>
  <joint name="pen_joint" type="fixed">
    <parent link="base_link"/>
    <child link="pen_link"/>
    <origin xyz="0.25 0 -0.05" rpy="0 0 0"/> 
  </joint>

  <link name="${prefix}_wheel">
  <visual>
    <geometry><cylinder radius="0.05" length="0.04"/></geometry>
    <material name="black"><color rgba="0 0 0 1"/></material>
  </visual>
  <collision>
    <geometry><cylinder radius="0.05" length="0.04"/></geometry>
  </collision>
  <inertial>
    <mass value="0.5"/>
    <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0006"/>
  </inertial>
</link>

<gazebo reference="${prefix}_wheel">
  <mu1>1.1</mu1>
  <mu2>1.1</mu2>
  <kp>1000000.0</kp>
  <kd>1.0</kd>
  <minDepth>0.001</minDepth>
</gazebo>

  <xacro:wheel prefix="front_left" x_reflect="1" y_reflect="1" />
  <xacro:wheel prefix="front_right" x_reflect="1" y_reflect="-1" />
  <xacro:wheel prefix="back_left" x_reflect="-1" y_reflect="1" />
  <xacro:wheel prefix="back_right" x_reflect="-1" y_reflect="-1" />

  <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="pen_link"><material>Gazebo/Red</material></gazebo>

  <ros2_control name="GazeboSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <xacro:macro name="wheel_interface" params="joint_name">
      <joint name="${joint_name}">
        <command_interface name="velocity"><param name="min">-20</param><param name="max">20</param></command_interface>
        <state_interface name="velocity"/><state_interface name="position"/>
      </joint>
    </xacro:macro>
    <xacro:wheel_interface joint_name="front_left_wheel_joint"/>
    <xacro:wheel_interface joint_name="front_right_wheel_joint"/>
    <xacro:wheel_interface joint_name="back_left_wheel_joint"/>
    <xacro:wheel_interface joint_name="back_right_wheel_joint"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg ros2_control_yaml)</parameters>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/model/artbot/odometry</odom_topic>
    </plugin>
  </gazebo>

  <gazebo reference="front_left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
</gazebo>
</robot>